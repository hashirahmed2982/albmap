<?xml version="1.0" encoding="utf-8"?>
<!-- Shown for the brief window between process start and Flutter's
     first frame, before SplashScreen (lib/features/splash) takes over.
     Matches that widget's gradient start color so the transition reads
     as one continuous screen instead of a white flash cutting to red. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
</layer-list>
