<?xml version="1.0" encoding="utf-8"?>
<!-- Same reasoning as drawable/launch_background.xml — kept as an
     explicit brand color rather than ?android:colorBackground so this
     doesn't flash black on a device in system dark mode (the app itself
     is forced to light theme regardless — see main.dart). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
</layer-list>
