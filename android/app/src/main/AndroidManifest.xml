<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Without INTERNET, every Dio API call, map tile fetch, and Firebase
      call fails outright — some plugin dependencies merge this in
      transitively, but it shouldn't be left implicit for a permission
      this core to the app. ACCESS_NETWORK_STATE backs connectivity_plus
      (the offline/online detection used to decide when to fall back to
      cached businesses). The two location permissions back
      geolocator/location (Discover Map's "near me" sort and centering).
      POST_NOTIFICATIONS is required on Android 13+ (API 33+) for the
      FirebaseMessaging.requestPermission() call in fcm_service.dart to
      have any effect — without this declared, that call is a no-op and
      push notifications never show, with no error surfaced anywhere.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="albmap"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Custom scheme for the "View my businesses" deep link in the
              business-approval email (see albmap-backend's email.js and
              the website's /app/my-businesses redirect page) — lets that
              link open this app directly instead of always landing on
              the website. Handled in DeepLinkService
              (lib/core/services/deep_link_service.dart).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="albmap" android:host="open"/>
            </intent-filter>
        </activity>
        <!--
          Required by google_maps_flutter — without this meta-data the
          map renders as a blank gray grid with a "For development
          purposes only" watermark (or nothing at all), regardless of
          anything set on the Dart side; this key is native-side config,
          not read from Dart at all. REPLACE with the real Maps SDK for
          Android key from Google Cloud Console (APIs & Services →
          Credentials), restricted to this app's package name
          (com.albmap.app) + release/debug signing SHA-1 fingerprints.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBjEMGTS_C0hox5DAi0nIK0iuEtkFkHtQw"/>
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id"/>
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token"/>
        <activity android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/app_name" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
