<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Albmap</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>albmap</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!--
	  Without these, iOS terminates the app the instant it calls the
	  corresponding permission API (Geolocator.getCurrentPosition,
	  ImagePicker.pickImage) instead of showing a system prompt — there is
	  no fallback behavior, just an immediate crash. Every one of these
	  maps to a permission this app actually requests:
	  discover_map_screen (location), and the logo/avatar/event-image
	  pickers in add_business/edit_profile/add_event (photo library).
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AlbMap uses your location to show nearby businesses and events and to sort results by distance.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AlbMap needs access to your photo library so you can choose a logo, profile photo, or event image.</string>
	<key>NSCameraUsageDescription</key>
	<string>AlbMap needs access to your camera so you can take a photo for your business logo, profile photo, or event image.</string>

	<!--
	  Facebook Login (flutter_facebook_auth) — App ID/Client Token are the
	  same real values already committed on the Android side
	  (android/app/src/main/res/values/strings.xml), since they identify
	  the one Facebook app shared by both platforms, not a per-platform
	  secret. Without FacebookAppID/ClientToken set, FacebookAuth.instance
	  .login() throws immediately at runtime ("You must set a valid
	  FacebookAppID"); without the fb<APP_ID> URL scheme + query schemes
	  below, the SDK can't hand control back to the app after the user
	  authenticates in Safari or the native Facebook app.
	-->
	<key>FacebookAppID</key>
	<string>1356530733257026</string>
	<key>FacebookClientToken</key>
	<string>e667c98c0512b5216a5201e1cf9da321</string>
	<key>FacebookDisplayName</key>
	<string>AlbMap</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fbauth2</string>
		<string>fb-messenger-share-api</string>
		<string>fbshareextension</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb1356530733257026</string>
			</array>
		</dict>
		<dict>
			<!--
			  Google Sign-In's redirect-back URL scheme. This MUST be the
			  REVERSED_CLIENT_ID from ios/Runner/GoogleService-Info.plist
			  once you've added it (see docs/FIREBASE_SOCIAL_LOGIN_SETUP.md)
			  — it's unique per Firebase iOS app registration, so it can't
			  ship pre-filled here. Until replaced, Google sign-in will open
			  the picker but never return control to the app.
			-->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>1:258633190602:ios:4390f46040566620ca3833</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
